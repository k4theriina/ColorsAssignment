@startuml usecase
' Use Case Diagram - COLORS LAMP web application
' Reflects public/js/code.js and api/*.php as implemented.
' Note: there is no registration use case; accounts are seeded directly in MySQL.

left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor "User" as user
actor "MySQL Database" as db <<system>>

rectangle "COLORS Web Application" {
  usecase "Log In" as UC_Login
  usecase "Validate Credentials\n(Login.php)" as UC_Validate
  usecase "Save Session Cookie" as UC_SaveCookie
  usecase "Check Session Cookie\n(readCookie on color.html)" as UC_CheckSession
  usecase "Search Colors" as UC_Search
  usecase "Add Color" as UC_Add
  usecase "Log Out" as UC_Logout
  usecase "Show Login Error" as UC_LoginError
}

user --> UC_Login
user --> UC_Search
user --> UC_Add
user --> UC_Logout

UC_Login ..> UC_Validate : <<include>>
UC_Login ..> UC_SaveCookie : <<include>>
UC_LoginError ..> UC_Login : <<extend>>\n[id < 1]

UC_Search ..> UC_CheckSession : <<include>>
UC_Add ..> UC_CheckSession : <<include>>

UC_Validate --> db
UC_Search --> db
UC_Add --> db

note right of UC_Search
  Partial (LIKE '%text%') match,
  limited to the logged-in user's colors
end note

note right of UC_Logout
  Clears cookie client-side only;
  no server call
end note

@enduml
